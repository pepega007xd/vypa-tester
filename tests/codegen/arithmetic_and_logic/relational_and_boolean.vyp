// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0

int sideEffect(string label) {
    print("SIDE_EFFECT:", label, "\n");
    return 1;
}

void main(void) {
    int r1;
    int r2;
    int r3;

    r1 = (3 < 5) && (5 <= 5) && (6 > 5) && (6 >= 6) && (4 == 4) && (4 != 5);
    r2 = !(0 || 0) && !5; // 1 && 0 = 0

    r3 = (0 && sideEffect("AND")) || (1 || sideEffect("OR"));

    print((string)r1, "|", (string)r2, "|", (string)r3, "\n");
}
