// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0

class Tag : Object {}

void main(void) {
    string s1;
    string s2;
    Tag t1;
    Tag t2;
    Tag n1;
    Tag n2;

    s1 = "ab" + "c";
    s2 = "a" + "bc";

    t1 = new Tag;
    t2 = new Tag;

    print((string)(s1 == s2), "|");
    print((string)(t1 == t2), "|");
    print((string)(t1 != t2), "|");
    print((string)(n1 == n2), "|");
    t2 = t1;
    print((string)(t1 == t2), "\n");
}
