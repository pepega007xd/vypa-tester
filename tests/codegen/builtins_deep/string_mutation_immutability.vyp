void appendLocal(string param) {
    param = param + "_modified";
}

void main(void) {
    string orig;
    string copy;
    orig = "base";
    copy = orig;
    orig = orig + "_changed";
    appendLocal(copy);
    print(orig, "|", copy, "\n");
}
