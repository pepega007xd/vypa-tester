// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY

class Marker : Object {}

void main(void) {
    int x;
    Marker m;
    x = 10;

    if (x > 5) {
        print("GT5 ");
    }

    if (x < 5) {
        print("UNREACHABLE ");
    }

    if (!m) {
        print("NULL ");
    }

    m = new Marker;
    if (m) {
        print("NONNULL ");
    } else {
        print("UNREACHABLE ");
    }

    print("\n");
}
