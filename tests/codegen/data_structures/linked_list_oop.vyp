// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY,FOR

class Node : Object {
    int val;
    Node next;

    void init(int v, Node n) {
        this.val = v;
        this.next = n;
    }
}

void main(void) {
    Node head;
    Node curr;
    int i;
    int sum;

    // Build list: 5 -> 4 -> 3 -> 2 -> 1
    for (i = 1; i <= 5; i = i + 1) {
        curr = new Node;
        curr.init(i, head);
        head = curr;
    }

    sum = 0;
    curr = head;
    while (curr) {
        sum = sum + curr.val;
        curr = curr.next;
    }

    print((string)sum, "\n");
}
