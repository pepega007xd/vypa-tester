// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY

int fib(int n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int ack(int m, int n) {
    if (m == 0) {
        return n + 1;
    }
    if (n == 0) {
        return ack(m - 1, 1);
    }
    return ack(m - 1, ack(m, n - 1));
}

void main(void) {
    print((string)fib(10), "|", (string)ack(2, 3), "\n");
}
