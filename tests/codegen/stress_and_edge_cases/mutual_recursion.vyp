// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY

int isEven(int n) {
    if (n == 0) {
        return 1;
    }
    return isOdd(n - 1);
}

int isOdd(int n) {
    if (n == 0) {
        return 0;
    }
    return isEven(n - 1);
}

void main(void) {
    print((string)isEven(12), "|", (string)isOdd(12), "|", (string)isOdd(13), "\n");
}
