void main(void) {
    string acc;
    int i;
    acc = "";
    for (i = 0; i < 25; i = i + 1) {
        acc = acc + "ab";
    }
    print((string)length(acc), "|", subStr(acc, 0, 4), "|", subStr(acc, 46, 4), "\n");
}
