void main(void) {
    string s;
    string str;
    s = "VYPlanguage";
    str = "cesky";

    print((string)length(s), "|", (string)length(""), "|", (string)length(str), "\n");
    print(subStr(s, 0, 3), "|", subStr(s, 3, 8), "|", subStr(s, 3, 100), "\n");
    print("[", subStr(s, 1, 0), "]|[", subStr(s, 11, 2), "]|[", subStr(s, 2, 0), "]|[", subStr(s, 2, 0), "]\n");
    print(subStr(str, 1, 3), "\n");
}
