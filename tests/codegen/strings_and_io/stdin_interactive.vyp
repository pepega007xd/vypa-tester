void main(void) {
    int count;
    int i;
    int sum;
    string label;

    label = readString();
    count = readInt();
    sum = 0;

    for (i = 0; i < count; i = i + 1) {
        sum = sum + readInt();
    }

    print(label, "=", (string)sum, "\n");
}
