// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY,FOR

class AVLNode : Object {
    int key;
    int h;
    AVLNode left;
    AVLNode right;

    AVLNode init(int k) {
        this.key = k;
        this.h = 1;
        return this;
    }
}

int getH(AVLNode n) {
    if (!n) {
        return 0;
    }
    return n.h;
}

int maxInt(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

void updateH(AVLNode n) {
    n.h = 1 + maxInt(getH(n.left), getH(n.right));
}

int balanceFactor(AVLNode n) {
    if (!n) {
        return 0;
    }
    return getH(n.left) - getH(n.right);
}

AVLNode rotateRight(AVLNode y) {
    AVLNode x;
    AVLNode t2;
    x = y.left;
    t2 = x.right;
    x.right = y;
    y.left = t2;
    updateH(y);
    updateH(x);
    return x;
}

AVLNode rotateLeft(AVLNode x) {
    AVLNode y;
    AVLNode t2;
    y = x.right;
    t2 = y.left;
    y.left = x;
    x.right = t2;
    updateH(x);
    updateH(y);
    return y;
}

AVLNode avlInsert(AVLNode node, int key) {
    int bf;
    if (!node) {
        return (new AVLNode).init(key);
    }
    if (key < node.key) {
        node.left = avlInsert(node.left, key);
    } else {
        if (key > node.key) {
            node.right = avlInsert(node.right, key);
        } else {
            return node;
        }
    }

    updateH(node);
    bf = balanceFactor(node);

    // LL
    if (bf > 1) {
        if (key < node.left.key) {
            return rotateRight(node);
        }
        if (key > node.left.key) {
            node.left = rotateLeft(node.left);
            return rotateRight(node);
        }
    }
    // RR / RL
    if (bf < (0 - 1)) {
        if (key > node.right.key) {
            return rotateLeft(node);
        }
        if (key < node.right.key) {
            node.right = rotateRight(node.right);
            return rotateLeft(node);
        }
    }
    return node;
}

void printPreorder(AVLNode n) {
    if (!n) {
        return;
    }
    print((string)n.key, "(", (string)balanceFactor(n), ") ");
    printPreorder(n.left);
    printPreorder(n.right);
}

void main(void) {
    AVLNode root;
    int i;
    for (i = 1; i <= 15; i = i + 1) {
        root = avlInsert(root, i);
    }
    print("AVL_HEIGHT:", (string)getH(root), "\n");
    printPreorder(root);
    print("\n");
}
