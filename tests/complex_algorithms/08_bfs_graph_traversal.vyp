// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY,FOR

class IntNode : Object {
    int val;
    IntNode next;
    IntNode init(int v, IntNode n) { this.val = v; this.next = n; return this; }
}

class Queue : Object {
    IntNode head;
    IntNode tail;

    void enqueue(int v) {
        IntNode node;
        IntNode nullNode;
        node = (new IntNode).init(v, nullNode);
        if (!this.tail) {
            this.head = node;
            this.tail = node;
        } else {
            this.tail.next = node;
            this.tail = node;
        }
    }

    int dequeue(void) {
        int v;
        v = this.head.val;
        this.head = this.head.next;
        if (!this.head) {
            this.tail = this.head;
        }
        return v;
    }

    int isEmpty(void) {
        return !this.head;
    }
}

class BfsNode : Object {
    int id;
    int level;
    IntNode adj;
    BfsNode next;
    BfsNode init(int i, BfsNode n) { this.id = i; this.level = 0 - 1; this.next = n; return this; }
}

BfsNode getBfsNode(BfsNode g, int id) {
    while (g) {
        if (g.id == id) { return g; }
        g = g.next;
    }
    return g;
}

void connectUndirected(BfsNode g, int a, int b) {
    BfsNode na;
    BfsNode nb;
    na = getBfsNode(g, a);
    nb = getBfsNode(g, b);
    na.adj = (new IntNode).init(b, na.adj);
    nb.adj = (new IntNode).init(a, nb.adj);
}

void main(void) {
    BfsNode g;
    Queue q;
    int i;

    for (i = 6; i >= 0; i = i - 1) {
        g = (new BfsNode).init(i, g);
    }
    connectUndirected(g, 0, 1);
    connectUndirected(g, 0, 2);
    connectUndirected(g, 1, 3);
    connectUndirected(g, 2, 3);
    connectUndirected(g, 3, 4);
    connectUndirected(g, 4, 5);

    getBfsNode(g, 0).level = 0;
    q = new Queue;
    q.enqueue(0);

    while (!q.isEmpty()) {
        int u;
        BfsNode un;
        IntNode e;
        u = q.dequeue();
        un = getBfsNode(g, u);
        e = un.adj;
        while (e) {
            BfsNode vn;
            vn = getBfsNode(g, e.val);
            if (vn.level == (0 - 1)) {
                vn.level = un.level + 1;
                q.enqueue(vn.id);
            }
            e = e.next;
        }
    }

    for (i = 0; i <= 6; i = i + 1) {
        print((string)getBfsNode(g, i).level, " ");
    }
    print("\n");
}
