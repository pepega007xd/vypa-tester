// TEST-INFO compiler-return-code 0
// TEST-INFO interpreter-return-code 0
// TEST-INFO required-extensions IFONLY,FOR

class StackNode : Object {
    int val;
    StackNode next;
    StackNode init(int v, StackNode n) { this.val = v; this.next = n; return this; }
}

class IntStack : Object {
    StackNode top;

    void push(int v) {
        this.top = (new StackNode).init(v, this.top);
    }

    int pop(void) {
        int v;
        v = this.top.val;
        this.top = this.top.next;
        return v;
    }
}

int parseIntToken(string tok) {
    int i;
    int sign;
    int res;
    int len;
    sign = 1;
    i = 0;
    len = length(tok);
    if (len > 0) {
        if (subStr(tok, 0, 1) == "-") {
            sign = 0 - 1;
            i = 1;
        }
    }
    res = 0;
    while (i < len) {
        string d;
        int digit;
        d = subStr(tok, i, 1);
        digit = 0;
        if (d == "1") { digit = 1; }
        if (d == "2") { digit = 2; }
        if (d == "3") { digit = 3; }
        if (d == "4") { digit = 4; }
        if (d == "5") { digit = 5; }
        if (d == "6") { digit = 6; }
        if (d == "7") { digit = 7; }
        if (d == "8") { digit = 8; }
        if (d == "9") { digit = 9; }
        res = res * 10 + digit;
        i = i + 1;
    }
    return sign * res;
}

void applyToken(IntStack st, string tok) {
    if (tok == "+" || tok == "-" || tok == "*" || tok == "/") {
        int b;
        int a;
        b = st.pop();
        a = st.pop();
        if (tok == "+") { st.push(a + b); }
        if (tok == "-") { st.push(a - b); }
        if (tok == "*") { st.push(a * b); }
        if (tok == "/") { st.push(a / b); }
        return;
    }
    st.push(parseIntToken(tok));
}

void main(void) {
    string expr;
    IntStack st;
    int i;
    int start;
    int len;

    expr = readString();
    st = new IntStack;
    len = length(expr);
    start = 0;

    for (i = 0; i <= len; i = i + 1) {
        int isSep;
        isSep = 0;
        if (i == len) {
            isSep = 1;
        } else {
            if (subStr(expr, i, 1) == " ") {
                isSep = 1;
            }
        }
        if (isSep) {
            if (i > start) {
                applyToken(st, subStr(expr, start, i - start));
            }
            start = i + 1;
        }
    }

    print((string)st.pop(), "\n");
}
